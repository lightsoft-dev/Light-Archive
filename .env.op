# Light Archive 개발 환경변수 — 1Password 참조
#
# 이 파일은 저장소에 커밋된다. 실제 값이 아니라 1Password 참조만 담기 때문이다.
#
#   1) 1Password 로그인       op signin
#   2) 실제 .env.local 생성    op inject -i .env.op -o .env.local
#
# 값을 바꿔야 하면 1Password 항목을 고친다. 여기 참조는 그대로 둔다.
# 접근 권한이 없으면 op inject 가 실패한다 — Shared 볼트 공유를 요청한다.
#
# ⚠ 참조는 **항목 ID**로 쓴다. 제목에 공백이 있으면 op 가 거기서 끊어 읽고
#   "too few '/'" 로 실패한다. ID 는 공백이 없어 안전하고, 제목이 바뀌어도 안 깨진다.
#   어느 항목인지는 아래 주석이 알려준다.
#   (op inject 는 주석 줄의 참조도 해석한다. 주석에 예시 참조를 적으면 그것까지
#    치환하려다 실패하므로, 설명에는 실제 참조 문법을 쓰지 않는다)

# ── Supabase ────────────────────────────────────────────────────────────────
# 1Password: "Light Archive - 개발 환경변수"
# URL·anon key 는 공개 사이트 번들에 실리므로 비밀이 아니다(편의상 같이 관리).
NEXT_PUBLIC_SUPABASE_URL=op://Shared/wsilportxuzzckcjahj5nsldrm/NEXT_PUBLIC_SUPABASE_URL

# 1Password: "라이트소프트 ERP - Supabase anon key"
NEXT_PUBLIC_SUPABASE_ANON_KEY=op://Shared/v6m2bsgnkubia4gs6pc2x5g25q/password

# 1Password: "라이트소프트 ERP - Supabase service_role key"
# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 회사 ERP 와 같은 Supabase 프로젝트의 키라서 ERP 테이블에도 접근된다. 다루는 데 주의.
SUPABASE_SERVICE_ROLE_KEY=op://Shared/n3ppfpgeh6nqqinfvqjllpfkqi/password

# ── 앱 토큰 ─────────────────────────────────────────────────────────────────
# 1Password: "Light Archive - 개발 환경변수"
OPENAI_API_KEY=op://Shared/wsilportxuzzckcjahj5nsldrm/OPENAI_API_KEY
LIGHT_ARCHIVE_PUBLISH_TOKEN=op://Shared/wsilportxuzzckcjahj5nsldrm/LIGHT_ARCHIVE_PUBLISH_TOKEN
SKILL_PREVIEW_TOKEN=op://Shared/wsilportxuzzckcjahj5nsldrm/SKILL_PREVIEW_TOKEN
ADMIN_SESSION_SECRET=op://Shared/wsilportxuzzckcjahj5nsldrm/ADMIN_SESSION_SECRET

# ── 로컬 전용 ───────────────────────────────────────────────────────────────
# 운영 비밀번호를 여기 넣지 않는다. 로컬 /admin 로그인에만 쓰는 값이라 아무거나 된다.
# 운영 값은 1Password "Light Archive - 관리자 계정" 과 Vercel 환경변수에 있다.
ADMIN_PASSWORD=local-dev-only
